// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`TimelineSwimlane > matches snapshot with mixed events including a cluster 1`] = `"<g class="swimlane"><rect x="0" y="0" fill="transparent" width="100" height="2000"></rect><g class="event-dot svelte-1mr1va2" role="button" tabindex="0" style="cursor: pointer"><!----><circle class="hover-ring svelte-1mr1va2" fill="none" stroke="var(--accent)" stroke-width="1.5" opacity="0" cx="50" cy="100" r="9"></circle><circle cx="50" cy="100" r="7" fill="var(--rule-border-0)" opacity="0.8"><title>2 events</title><!----></circle><!----></g><g class="event-dot svelte-1mr1va2" role="button" tabindex="0" style="cursor: pointer"><!----><circle class="hover-ring svelte-1mr1va2" fill="none" stroke="var(--accent)" stroke-width="1.5" opacity="0" cx="50" cy="300" r="7"></circle><circle cx="50" cy="300" r="5" fill="var(--purple)" opacity="0.7"><!----><!----></circle><!----></g><g class="event-dot svelte-1mr1va2" role="button" tabindex="0" style="cursor: pointer"><!----><circle class="hover-ring svelte-1mr1va2" fill="none" stroke="var(--accent)" stroke-width="1.5" opacity="0" cx="50" cy="500" r="7"></circle><circle cx="50" cy="500" r="5" fill="var(--rule-border-2)" opacity="0.7"><!----><!----></circle><!----></g><!----></g>"`;
