// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AnalysisView > matches snapshot with results in table mode 1`] = `"<div class="header-row svelte-1eulaw8"><h2 class="svelte-1eulaw8">Analysis</h2> <div class="header-actions svelte-1eulaw8"><button class="primary">Run Analysis</button> <button>Export</button><!----></div></div> <!----> <div class="time-range-toggle svelte-1eulaw8"><button class="time-range-chip svelte-1eulaw8">Time Range: All</button> <!----> <!----></div> <!----> <div class="results-summary card svelte-1eulaw8"><h3>Results</h3> <div class="summary-stats svelte-1eulaw8"><div class="stat svelte-1eulaw8"><span class="stat-value svelte-1eulaw8">1</span> <span class="stat-label svelte-1eulaw8">Rule Matches</span></div> <div class="stat svelte-1eulaw8"><span class="stat-value svelte-1eulaw8">1</span> <span class="stat-label svelte-1eulaw8">Pattern Matches</span></div> <div class="stat svelte-1eulaw8"><span class="stat-value svelte-1eulaw8">1</span> <span class="stat-label svelte-1eulaw8">State Changes</span></div></div> <div class="filter-facets svelte-1eulaw8"><div class="facet-group svelte-1eulaw8"><span class="facet-label svelte-1eulaw8">Rules</span> <div class="facet-chips svelte-1eulaw8"><button class="facet-chip svelte-1eulaw8">Error Rule <span class="chip-count svelte-1eulaw8">1</span></button></div></div> <div class="facet-group svelte-1eulaw8"><span class="facet-label svelte-1eulaw8">Sources</span> <div class="facet-chips svelte-1eulaw8"><button class="facet-chip svelte-1eulaw8" style="color: var(--accent);">app.log <span class="chip-count svelte-1eulaw8">1</span></button></div></div> <!----></div><!----></div> <div class="view-tabs svelte-1eulaw8"><button class="svelte-1eulaw8 active">Event Feed</button> <button class="svelte-1eulaw8">Table</button> <button class="svelte-1eulaw8">Logs</button> <button class="svelte-1eulaw8">Clusters</button></div> <!----><!----><!----><!----><div class="density-histogram card svelte-1otgt6l"><span class="histogram-title svelte-1otgt6l">Match Density</span> <svg width="100%" height="80" class="svelte-1otgt6l selectable"><text y="10" fill="var(--text-muted)" font-size="10" font-family="var(--font-mono)" text-anchor="end" x="28">1</text><text fill="var(--text-muted)" font-size="10" font-family="var(--font-mono)" text-anchor="end" x="28" y="60">0</text><line y1="0" stroke="var(--border)" stroke-width="1" x1="32" x2="32" y2="60"></line><!----><rect class="bar svelte-1otgt6l clickable" x="36" y="0" width="558" height="60" opacity="0.7"></rect><!----><text fill="var(--text-muted)" font-size="10" font-family="var(--font-mono)" y="76" x="36" text-anchor="start">01/15 10:30</text><!----></svg> <!----></div><!----> <div class="event-feed svelte-4qgr4g"><div class="filter-bar svelte-4qgr4g"><label class="svelte-4qgr4g">Source <select class="svelte-4qgr4g"><option value="all">All sources</option><option value="1">app.log</option><!----></select></label> <label class="svelte-4qgr4g">Rule <select class="svelte-4qgr4g"><option value="all">All rules</option><option value="1">Error Rule</option><option value="2">Warn Rule</option><!----></select></label> <label class="svelte-4qgr4g">Key <select class="svelte-4qgr4g"><option value="all">All keys</option><option value="status">status</option><!----></select></label> <span class="count svelte-4qgr4g">1 event</span></div> <div class="feed svelte-4qgr4g"><!----><div class="event-card svelte-4qgr4g"><div class="color-bar svelte-4qgr4g" style="background: var(--accent);"></div> <div class="card-body svelte-4qgr4g"><div class="card-headline svelte-4qgr4g"><span class="ts svelte-4qgr4g" title="2024-01-15T10:30:00.000">Jan 15, 10:30:00</span> <span class="source-name svelte-4qgr4g" style="color: var(--accent);">app.log</span> <span class="event-text svelte-4qgr4g"><span class="rule-name-fallback svelte-4qgr4g">[Error Rule]</span><!----></span></div> <div class="card-chips-row svelte-4qgr4g"><span class="chips-label svelte-4qgr4g">↳</span> <span class="state-chip svelte-4qgr4g" title="new key">status <span class="chip-arrow svelte-4qgr4g">→</span> <span class="chip-value svelte-4qgr4g">error_detected</span><!----></span><!----><!----> <div class="card-actions svelte-4qgr4g"><button type="button" title="Toggle raw log line" class="action-btn svelte-4qgr4g">▶ raw</button> <button type="button" title="Toggle state at this moment" class="action-btn svelte-4qgr4g">≡ state </button> <button type="button" title="Toggle rule details" class="action-btn svelte-4qgr4g">⊞ rule</button></div></div> <!----> <!----> <!----></div></div><!----><div class="event-card svelte-4qgr4g"><div class="color-bar svelte-4qgr4g" style="background:var(--purple)"></div> <div class="card-body svelte-4qgr4g"><div class="card-headline svelte-4qgr4g"><span class="ts svelte-4qgr4g" title="2024-01-15T10:30:05.000">Jan 15, 10:30:05</span> <span style="color:var(--purple);font-size:12px">◆</span> <span style="color:var(--purple);font-weight:600">Pattern matched: Failure Pattern</span></div> <div class="card-chips-row svelte-4qgr4g"><div class="card-actions svelte-4qgr4g"><button type="button" title="Toggle pattern state snapshot" class="action-btn svelte-4qgr4g">≡ state </button></div></div> <!----></div></div></div><!----></div><!----><!----><!---->"`;
